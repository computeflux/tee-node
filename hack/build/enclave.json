{
    "exe": "dsecret",
    "key": "./keys/private.pem",
    "debug": true,
    "heapSize": 512,
    "executableHeap": false,
    "productID": 1,
    "securityVersion": 1,
    "mounts": [
        {
            "source": "/token_chain_data",
            "target": "/token_chain_data",
            "type": "hostfs",
            "readOnly": false
        }
    ],
    "env": [
        {
            "name": "SIDE_CHAIN_PORT",
            "fromHost": true
        },
        {
            "name": "SIDE_CHAIN_ADDR",
            "fromHost": true
        },
        {
            "name": "GQL_PORT",
            "fromHost": true
        },
        {
            "name": "CHAIN_ENV",
            "fromHost": true
        },
        {
            "name": "JWT_SECRET",
            "fromHost": true
        },
        {
            "name": "SEED_SECRET",
            "fromHost": true
        },
        {
            "name": "MOCK_EMAIL",
            "fromHost": true
        },
        {
            "name": "CORS_ORIGINS",
            "fromHost": true
        },
        {
            "name": "GOOGLE_CLIENT_ID",
            "fromHost": true
        },
        {
            "name": "GOOGLE_CLIENT_SECRET",
            "fromHost": true
        },
        {
            "name": "GOOGLE_REDIRECT_URL",
            "fromHost": true
        },
        {
            "name": "GITHUB_CLIENT_ID",
            "fromHost": true
        },
        {
            "name": "GITHUB_CLIENT_SECRET",
            "fromHost": true
        },
        {
            "name": "GITHUB_REDIRECT_URL",
            "fromHost": true
        },
        {
            "name": "TWITTER_CLIENT_ID",
            "fromHost": true
        },
        {
            "name": "TWITTER_CLIENT_SECRET",
            "fromHost": true
        },
        {
            "name": "TWITTER_REDIRECT_URL",
            "fromHost": true
        },
        {
            "name": "SMTP_HOST",
            "fromHost": true
        },
        {
            "name": "SMTP_PORT",
            "fromHost": true
        },
        {
            "name": "SMTP_USER",
            "fromHost": true
        },
        {
            "name": "SMTP_PASSWORD",
            "fromHost": true
        },
        {
            "name": "SMTP_FROM",
            "fromHost": true
        },
        {
            "name": "SMTP_FROM_NAME",
            "fromHost": true
        }
    ],
    "files": [
        {
            "source": "/etc/ssl/certs/ca-certificates.crt",
            "target": "/etc/ssl/certs/ca-certificates.crt"
        }
    ]
}
