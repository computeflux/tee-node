# SMTP 真实发信测试的本地凭据模板。
#
# 用法：
#   1. 复制本文件为 smtp_test.env（smtp_test.env 已被 .gitignore 忽略，不会提交到仓库）
#   2. 填入真实 SMTP 凭据
#   3. 运行：
#        go test -count=1 -v -run TestSMTPEmailService_SendOTP ./ext/
#
# 环境变量 SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD /
# SMTP_FROM / SMTP_FROM_NAME / SMTP_RECIPIENT 可覆盖文件中的同名配置。
# 未配置（或 SMTP_HOST 仍是占位符 smtp.example.com）时测试自动跳过。

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Computeflux
SMTP_RECIPIENT=
