type EarlyAccessUser {
  isUser: Boolean!
  wallet: String
  joinedAt: String
  referrer: String
  referralCode: String
  email: String
}

type EarlyAccessPoints {
  total: String!
}

type ReferralInfo {
  code: String
  alias: String
  referrer: String
  earnings: String!
  pending: Int!
  referrals: [String!]!
}

type PointsHistoryItem {
  amount: String!
  reason: String!
  timestamp: String!
  relatedUser: String
  relatedEmail: String
}

type PointsHistory {
  items: [PointsHistoryItem!]!
  total: Int!
}

type EarlyAccessStats {
  userCount: Int!
  totalPointsDistributed: String!
  totalReferrals: Int!
}

type JoinEarlyAccessResult {
  success: Boolean!
  txHash: String
  warning: String
  referralAwarded: Boolean!
}

enum EarlyAccessTaskType {
  JOIN_EARLY_ACCESS
  VERIFY_EMAIL
  CONNECT_WALLET
  JOIN_DISCORD
  JOIN_TELEGRAM
  INVITE_FRIEND
}

type TaskStatus {
  task: EarlyAccessTaskType!
  completed: Boolean!
  claimedAt: String
}

type ClaimTaskResult {
  success: Boolean!
  pointsAwarded: String!
  totalPoints: String!
}

type CheckinConfig {
  testMode: Boolean!
}

type CheckinResult {
  success: Boolean!
  streak: Int!
  pointsAwarded: String!
  totalPoints: String!
  unlockedDay3: Boolean!
  unlockedDay7: Boolean!
}

type CheckinStatus {
  checkedIn: Boolean!
  canCheckin: Boolean!
  weekCount: Int!
  weekMax: Int!
  streak: Int!
}

type QuizQuestion {
  id: String!
  day: Int!
  difficulty: String!
  category: String!
  question: String!
  options: [String!]!
}

type QuizProgress {
  total: Int!
  answered: Int!
  earned: String!
}

type QuizAnswerResult {
  correct: Boolean!
  pointsAwarded: String!
  totalPoints: String!
  explanation: String!
}

type AntiSybilConfig {
  ipCheckEnabled: Boolean!
  deferredSettlementEnabled: Boolean!
  updatedBy: String
  updatedAt: String
}

type AntiSybilConfigResult {
  success: Boolean!
  message: String!
}

type ReferralBonus {
  code: String!
  bonusPoints: Int!
  updatedBy: String
  updatedAt: String
}

type ReferralBonusResult {
  success: Boolean!
  message: String!
}

# 加入前预检查：查询当前 IP 使用该邀请码加入是否可获得推荐奖励
# （与 joinEarlyAccess 中的防女巫逻辑一致，供前端在提交加入前提示用户）
type ReferralEligibilityResult {
  eligible: Boolean!
  reason: String
}

type Query {
  earlyAccessUser(user: String!): EarlyAccessUser!
  earlyAccessUserByEmail(email: String!): EarlyAccessUser!
  earlyAccessUserByReferralCode(referralCode: String!): EarlyAccessUser!
  earlyAccessPoints(user: String!): EarlyAccessPoints!
  earlyAccessReferral(user: String!): ReferralInfo!
  earlyAccessPointsHistory(user: String!, offset: Int, limit: Int): PointsHistory!
  earlyAccessStats: EarlyAccessStats!
  earlyAccessTasks(wallet: String!): [TaskStatus!]!
  earlyAccessExport: String!
  checkinStreak(wallet: String!): Int!
  checkinStatus(wallet: String!): CheckinStatus!
  checkinConfig: CheckinConfig!
  quizQuestions(wallet: String!, day: Int!): [QuizQuestion!]!
  quizProgress(wallet: String!, day: Int!): QuizProgress!
  antiSybilConfig: AntiSybilConfig!
  referralBonusConfigs: [ReferralBonus!]!
  # wallet 可空：传入时额外检查是否已加入/是否使用自己的邀请码；为空时仅做同 IP 判断
  referralEligibility(wallet: String, referralCode: String!): ReferralEligibilityResult!
}

type Mutation {
  joinEarlyAccess(wallet: String!, email: String, referralCode: String): JoinEarlyAccessResult!
  updateReferralCode(wallet: String!, referralCode: String!): JoinEarlyAccessResult!
  updateReferralAlias(wallet: String!, alias: String!, signature: String!): JoinEarlyAccessResult!
  claimEarlyAccessTask(wallet: String!, task: EarlyAccessTaskType!): ClaimTaskResult!
  joinDiscord(wallet: String!, message: String!, signature: String!): ClaimTaskResult!
  joinTelegram(wallet: String!, message: String!, signature: String!): ClaimTaskResult!
  dailyCheckin(wallet: String!, date: String): CheckinResult!
  submitQuizAnswer(wallet: String!, questionId: String!, answerIndex: Int!): QuizAnswerResult!
  updateAntiSybilConfig(wallet: String!, password: String!, ipCheckEnabled: Boolean!, deferredSettlementEnabled: Boolean!): AntiSybilConfigResult!
  setReferralBonus(wallet: String!, password: String!, code: String!, bonusPoints: Int!): ReferralBonusResult!
}
