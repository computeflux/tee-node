type ChainInfo {
  is_main: Boolean!
  subnet_contract: String!
  """链类型（如 local / test / main）"""
  chain_type: String!
  """展示用网络名称（如 Paseo / Polkadot）"""
  network_label: String!
  """链节点 URL 列表"""
  urls: [String!]!
}

extend type Query {
  chain_info: [ChainInfo!]!
  validators: [String!]!
  """区块详情（区块头 + 区块内交易列表），按高度或哈希查询"""
  block_detail(height: Int, hash: String): BlockDetail
  """地址当前余额（gov 合约 balanceOf），address 为 SS58 或 hex 公钥"""
  address_balance(address: String!): AddressBalance
  """地址交易列表（区分收/发方向，分页），从最新区块向前扫描"""
  address_txs(address: String!, page: Int, pageSize: Int): AddressTxsPage
}

type AddressBalance {
  """地址（原样回显）"""
  address: String!
  """当前余额（十进制字符串，U256）"""
  balance: String!
}

type AddressTx {
  """交易哈希（hex，无 0x 前缀）"""
  hash: String!
  """区块高度"""
  height: Int!
  """交易在区块内的索引"""
  index: Int!
  """出块时间（RFC3339）"""
  time: String!
  """方向：in=收 / out=发"""
  direction: String!
  """金额（十进制字符串，仅转账类交易；其余为 null）"""
  amount: String
  """对手方地址（SS58；无法识别时为 null）"""
  counterparty: String
}

type AddressTxsPage {
  """当前页交易（时间倒序）"""
  txs: [AddressTx!]!
  """扫描窗口内命中的交易总数"""
  total: Int
  """是否还有下一页"""
  hasMore: Boolean!
}

type BlockDetail {
  """区块高度"""
  height: Int!
  """区块哈希（hex，无 0x 前缀）"""
  hash: String!
  """出块时间（RFC3339）"""
  time: String!
  """链 ID"""
  chain_id: String!
  """出块节点（proposer address，hex）"""
  proposer: String!
  """上一区块哈希（hex）"""
  prev_hash: String
  """应用哈希（hex）"""
  app_hash: String
  """数据哈希（hex）"""
  data_hash: String
  """区块内交易列表"""
  txs: [BlockTx!]!
}

type BlockTx {
  """交易在区块内的索引"""
  index: Int!
  """交易哈希（hex，无 0x 前缀）"""
  hash: String!
}

extend type Mutation {
  start_epoch: Boolean!
}