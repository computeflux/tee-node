type ChainInfo {
  is_main: Boolean!
  subnet_contract: String!
  """链类型（如 local / test / main）"""
  chain_type: String!
  """展示用网络名称（如 Paseo / Polkadot）"""
  network_label: String!
  """链节点 URL 列表"""
  urls: [String!]!
}

extend type Query {
  chain_info: [ChainInfo!]!
  validators: [String!]!
  """区块详情（区块头 + 区块内交易列表），按高度或哈希查询"""
  block_detail(height: Int, hash: String): BlockDetail
  """交易详情（按交易哈希查询），含 From/To/状态/所在区块"""
  tx_detail(hash: String!): TxDetail
  """链状态总览：最新区块高度/时间、总交易数、总地址数、最近区块列表、最近交易列表"""
  chain_overview(blockLimit: Int, txLimit: Int): ChainOverview
  """地址当前余额（gov 合约 balanceOf）。address 支持 SS58 / hex 公钥 / EVM 0x 地址（统一归一化为 UniAddr）"""
  address_balance(address: String!): AddressBalance
  """地址交易列表（收/发方向 + 金额 + 对手方，分页）。address 支持 SS58 / hex 公钥 / EVM 0x 地址"""
  address_txs(address: String!, page: Int, pageSize: Int): AddressTxs
}

type AddressBalance {
  """归一化后的地址展示形式（SS58 或 0x EVM 地址）"""
  address: String!
  """当前余额（十进制字符串，U256）"""
  balance: String!
}

type AddressTxs {
  """交易列表（时间倒序）"""
  txs: [AddressTx!]!
  """扫描窗口内命中的交易总数"""
  total: Int
  """是否还有下一页"""
  hasMore: Boolean!
}

type AddressTx {
  """交易哈希（hex，无 0x 前缀）"""
  hash: String!
  """所在区块高度"""
  height: Int!
  """交易在区块内的索引"""
  index: Int!
  """出块时间（RFC3339）"""
  time: String!
  """方向：in=收 / out=发"""
  direction: String!
  """金额（十进制字符串，仅转账类交易；其余为 null）"""
  amount: String
  """对手方地址（SS58 或 0x EVM 地址；无法识别时为 null）"""
  counterparty: String
}

type ChainOverview {
  """最新区块高度"""
  latest_height: Int!
  """最新区块出块时间（RFC3339）"""
  latest_time: String!
  """总交易数"""
  total_txs: Int!
  """总地址数（曾发起过交易的地址数）"""
  total_addresses: Int!
  """最近区块列表（按高度降序）"""
  blocks: [ChainOverviewBlock!]!
  """最近交易列表（按时间降序）"""
  txs: [ChainOverviewTx!]!
}

type ChainOverviewBlock {
  """区块高度"""
  height: Int!
  """区块哈希（hex，无 0x 前缀）"""
  hash: String!
  """出块时间（RFC3339）"""
  time: String!
  """区块内交易数"""
  num_txs: Int!
}

type ChainOverviewTx {
  """交易哈希（hex，无 0x 前缀）"""
  hash: String!
  """所在区块高度"""
  height: Int!
  """出块时间（RFC3339）"""
  time: String!
  """执行码（0 = 成功）"""
  code: Int!
  """是否成功"""
  success: Boolean!
}

type BlockDetail {
  """区块高度"""
  height: Int!
  """区块哈希（hex，无 0x 前缀）"""
  hash: String!
  """出块时间（RFC3339）"""
  time: String!
  """链 ID"""
  chain_id: String!
  """出块节点（proposer address，hex）"""
  proposer: String!
  """上一区块哈希（hex）"""
  prev_hash: String
  """应用哈希（hex）"""
  app_hash: String
  """数据哈希（hex）"""
  data_hash: String
  """区块内交易列表"""
  txs: [BlockTx!]!
}

type BlockTx {
  """交易在区块内的索引"""
  index: Int!
  """交易哈希（hex，无 0x 前缀）"""
  hash: String!
}

type TxDetail {
  """交易哈希（hex，无 0x 前缀）"""
  hash: String!
  """所在区块高度"""
  height: Int!
  """交易在区块内的索引"""
  index: Int!
  """出块时间（RFC3339）"""
  time: String!
  """执行码（0 = 成功）"""
  code: Int!
  """是否成功"""
  success: Boolean!
  """发起方地址（SS58）"""
  from: String
  """目标合约名（合约调用时）"""
  to: String
  """合约方法（合约调用时）"""
  method: String
  """合约参数（hex 列表，合约调用时）"""
  args: [String!]
  """用户级 nonce（合约调用时）"""
  nonce: Int
  """金额（本侧链为合约调用，通常无原生金额，留空）"""
  amount: String
  """Gas 用量"""
  gas_used: Int
  """Gas 上限"""
  gas_wanted: Int
  """原始交易字节（hex）"""
  data: String
  """事件（JSON 字符串）"""
  events: String
}

extend type Mutation {
  start_epoch: Boolean!
}