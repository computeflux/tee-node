# 通用智能合约调用（支持 dao 及后续其他 pallet）

extend type Query {
  """
  按合约查询，返回 base64(SCALE 编码结果)。
  dao：method 为查询方法名；args 每项为 hex(0x 可选)，内容为对应参数的 SCALE 编码字节（与 DecodeScaleArg 一致）。
  """
  contractDryRun(
    """ 调用方地址（32 字节 hex 或 SS58）"""
    caller: String!
    """ 地址类型，0 => TEE, 1 => polkadot_sign """
    callerType: Int!
    """ 合约名，如 dao """
    contract: String!
    """ 是否是操作函数 """
    mut: Boolean!
    """ dao：方法名，如 members、total_supply、balance_of """
    method: String!
    """ 每项 hex(SCALE(单参))，顺序与链上 ExecuteQuery 一致 """
    args: [String!]!
  ): String!

  contractNonce(
    """ 调用方地址（32 字节 hex 或 SS58）"""
    caller: String!
    """ 地址类型，0 => TEE, 1 => polkadot_sign """
    callerType: Int!
  ): Int!
}

extend type Mutation {
  """
  系统合约初始化
  """
  systemContractInit(contract: String!): Boolean! @AuthCheck

  """
  执行指定合约调用 gov:method 为方法名 args 为字符串参数列表
  链上 Tx.contract 为 SCALE(Method string, Args []byte)，Args 为 json.Marshal(args)，args 每项为 hex(SCALE(单参))。
  返回交易 hash，前端可用此 hash 通过 txStatus 查询执行结果。
  """
  contractCall(
    """ 调用方地址（32 字节 hex 或 SS58）"""
    caller: String!
    """ 地址类型，0 => TEE, 1 => polkadot_sign """
    callerType: Int!
    """ 用户级严格递增 nonce（从 1 开始）"""
    nonce: Int!
    """ 合约名，如 dao """
    contract: String!
    """ dao：方法名，如 join、transfer """
    method: String!
    """ 每项 hex(SCALE(单参))；init 为 3～4 个参数分别编码 members、publicJoin、sudoAccount、[defaultTrack] """
    args: [String!]!
    """ 对 caller || caller_type || nonce || call 的签名"""
    signature: String!
  ): String!
}
