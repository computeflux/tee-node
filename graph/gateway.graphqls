# ── 类型定义 ────────────────────────────────────────────

type GatewayModel {
  id: Int!
  name: String!
  owner: String!
  pointsPer1K: Int!
  isActive: Boolean!
  createdAt: Int!
}

type GatewayProvider {
  id: Int!
  name: String!
  baseURL: String!
  modelIds: [Int!]!
  priority: Int!
  isActive: Boolean!
  owner: String!
}

type GatewayToken {
  id: Int!
  owner: String!
  rateLimit: Int!
  isActive: Boolean!
  createdAt: Int!
}

type PointsBalance {
  user: String!
  balance: Int!
}

type DailyUsage {
  tokenId: Int!
  channelId: Int!
  modelId: Int!
  day: String!
  count: Int!
  tokensUsed: Int!
  pointsUsed: Int!
}

# ── Mutation ────────────────────────────────────────────

extend type Mutation {
  """供应商注册模型，设定积分价格"""
  registerModel(name: String!, pointsPer1K: Int!): GatewayModel!

  """更新模型价格 (仅 owner)"""
  updateModel(modelId: Int!, pointsPer1K: Int!): GatewayModel!

  """下架模型"""
  deactivateModel(modelId: Int!): Boolean!

  """供应商创建 Channel，关联已注册的模型"""
  createProvider(name: String!, baseURL: String!, modelIds: [Int!]!, priority: Int!): GatewayProvider!

  """更新 Channel"""
  updateProvider(channelId: Int!, modelIds: [Int!], priority: Int): GatewayProvider!

  """创建 API Token"""
  createToken(rateLimit: Int!): GatewayToken!

  """吊销 API Token"""
  revokeToken(tokenId: Int!): Boolean!

  """管理员充值积分"""
  recharge(user: String!, amount: Int!): PointsBalance!

  """供应商提取模型收益"""
  withdraw(modelId: Int!, amount: Int!): PointsBalance!
}

# ── Query ───────────────────────────────────────────────

extend type Query {
  """查询用户积分余额"""
  pointsBalance(user: String!): PointsBalance!

  """查询模型详情"""
  gatewayModel(modelId: Int!): GatewayModel

  """分页列出所有模型"""
  listModels(startKey: Int, size: Int!): [GatewayModel!]!

  """查询 Provider 详情"""
  gatewayProvider(channelId: Int!): GatewayProvider

  """列出支持某模型的可用 Channel"""
  listActiveProviders(modelId: Int!): [GatewayProvider!]!

  """查询 Token 详情"""
  gatewayToken(tokenId: Int!): GatewayToken

  """分页列出用户 Token"""
  listUserTokens(user: String!, startKey: Int, size: Int!): [GatewayToken!]!

  """查询某天用量"""
  dailyUsage(tokenId: Int!, day: String!): DailyUsage
}

extend type Mutation {
  """动态调整连接池大小"""
  adjustPool(maxConnsPerHost: Int!): PoolStats!
}

extend type Query {
  """查看连接池状态"""
  poolStats: PoolStats!
}

type PoolStats {
  maxConnsPerHost: Int!
  maxIdleConns: Int!
  maxIdleConnsPerHost: Int!
  requestTimeout: String!
}
