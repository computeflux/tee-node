type ModelInfo {
  name: String!
  providerId: Int!
  modelType: Int!
  urls: String!
  thinking: Boolean!
  modelId: String!
  inputModalities: Int!
  contextLength: Int!
  inPrice: Int!
  cachedPrice: Int!
  outPrice: Int!
  isActive: Boolean!
  createdAt: Int!
}

type ProviderInfo {
  owner: String!
  name: String!
  logoUrl: String!
  description: String!
  modelIds: [Int!]!
  region: Int!
  deposit: Int!
  feeRate: Int!
  priority: Int!
  totalRequests: Int!
  successRate: Int!
  avgLatency: Int!
  uptimeSLA: Int!
  isActive: Boolean!
  createdAt: Int!
}

type RouteInfo {
  id: Int!
  name: String!
  routeType: Int!
  inPrice: Int!
  outPrice: Int!
  cachedPrice: Int!
  modelIds: [Int!]!
  isActive: Boolean!
  isOfficial: Boolean!
  createdAt: Int!
}

type ModelInfoWithProvider {
  id: Int!
  model: ModelInfo
  provider: ProviderInfo
  route: RouteInfo
}

type ModelRunningStatus {
  modelName: String!
  isRunning: Boolean!
}

# ── Query ─────────────────────────────────────────────
extend type Query {
  edge_models: [ModelInfo!]! @AuthCheck
  """获取活跃模型列表，支持按模型名关键字模糊搜索，以及上下文长度和价格区间筛选。
  ProviderType 为 9999 的个人算力会按本地隧道在线状态过滤。"""
  models(
    keyword: String
    minContext: Int
    maxContext: Int
    minPrice: Int
    maxPrice: Int
    modalities: Int
    offset: Int
    limit: Int
  ): [ModelInfoWithProvider!]!

  """批量查询指定 provider 下多个个人算力模型是否在线运行。
  返回每个模型名称及其本地隧道可用状态。"""
  edge_model_running_status(providerId: Int!, modelNames: [String!]!): [ModelRunningStatus!]!
}
