# ── 类型定义 ────────────────────────────────────────────

type AuthResponse {
  success: Boolean!
  userInfo: UserInfo
  token: String
  address: String
  error: String
}

type UserInfo {
  email: String!
  name: String
  profileImage: String
  verifier: String
  verifierId: String
  typeOfLogin: String
  aggregateVerifier: String
  authConnection: String
  authConnectionId: String
}

type OAuthURL {
  authUrl: String!
}

type WalletResult {
  status: String!
  result: String
  error: String
}

type SignSessionResult {
  status: String!
  signToken: String
  expiresAt: Int
  error: String
}

type RecoveryResult {
  status: String!
  recoveryToken: String
  token: String
  address: String
  email: String
  error: String
}

type ChallengeResult {
  status: String!
  challenge: String
  salt: String
  expiresAt: Int
  error: String
}

# ── 输入类型 ────────────────────────────────────────────

input AuthConfigInput {
  smtpHost: String!
  smtpPort: Int!
  smtpUser: String!
  smtpPassword: String!
  smtpFrom: String!
  smtpFromName: String!
  mockEmail: Boolean!
  googleClientID: String!
  googleClientSecret: String!
  googleRedirectURL: String!
  githubClientID: String!
  githubClientSecret: String!
  githubRedirectURL: String!
  twitterClientID: String!
  twitterClientSecret: String!
  twitterRedirectURL: String!
}

input TxInput {
  from: String!
  to: String!
  value: String
  data: String
  gas: String
  gasPrice: String
  nonce: String
  chainId: String
  passwordHash: String
}

# ── Mutation ────────────────────────────────────────────

extend type Mutation {
  """请求 OTP 验证码"""
  requestOTP(email: String!, clientId: String!): AuthResponse!

  """验证 OTP 并完成登录"""
  verifyOTP(email: String!, otp: String!, clientId: String!): AuthResponse!

  """社交登录"""
  socialLogin(
    provider: String!
    idToken: String
    code: String
    codeVerifier: String
    redirectUri: String
  ): AuthResponse!

  """设置交易密码（同时传入 passwordHash 用于加密私钥，以及 salt + dkHash 用于 challenge-response）"""
  setPassword(token: String!, passwordHash: String!, salt: String!, dkHash: String!): WalletResult!

  """验证交易密码，返回短期签名 token（旧接口，兼容模式）"""
  verifyPassword(token: String!, passwordHash: String!): SignSessionResult!

  """验证挑战响应，返回短期签名 token"""
  verifyResponse(token: String!, challenge: String!, response: String!): SignSessionResult!

  """签名交易"""
  signTransaction(token: String!, tx: TxInput!): WalletResult!

  """签名消息"""
  signMessage(token: String!, message: String!, from: String!, passwordHash: String): WalletResult!

  """发起社交恢复"""
  requestRecovery(recoveryEmail: String!): RecoveryResult!

  """验证恢复 OTP"""
  verifyRecovery(recoveryEmail: String!, otp: String!): RecoveryResult!

  """完成恢复"""
  completeRecovery(recoveryToken: String!, passwordHash: String!): RecoveryResult!

  """领取订单 API Token"""
  claimOrderToken(address: String!, signature: String!, timestamp: Int!, orderId: Int!): AuthResponse!

  """请求钱包登录 nonce（一次性，5分钟有效）"""
  requestWalletNonce(address: String!): String!

  """外部钱包登录（MetaMask 等），通过签名验证身份后返回 API Token"""
  loginWithWallet(address: String!, signature: String!, message: String!): AuthResponse!

  """设置 Auth 合约配置（节点管理员调用）"""
  setAuthConfig(cfg: AuthConfigInput!): Boolean!
}

# ── 类型定义（对外公开，脱敏） ────────────────────────────

type AuthConfig {
  corsOrigins: String!
  smtpHost: String!
  smtpPort: Int!
  smtpUser: String!
  smtpPassword: String!
  smtpFrom: String!
  smtpFromName: String!
  mockEmail: Boolean!
  otpLength: Int!
  otpTtlMins: Int!
  googleClientID: String!
  googleClientSecret: String!
  googleRedirectURL: String!
  githubClientID: String!
  githubClientSecret: String!
  githubRedirectURL: String!
  twitterClientID: String!
  twitterClientSecret: String!
  twitterRedirectURL: String!
}

# ── Query ───────────────────────────────────────────────

extend type Query {
  """获取 OAuth 授权 URL"""
  oauthURL(provider: String!, redirectUri: String): OAuthURL!

  """认证服务健康检查"""
  authHealth: String!

  """获取签名挑战（用于 challenge-response 密码验证）"""
  getChallenge(token: String!): ChallengeResult!

  """获取 Auth 配置（对外公开，已脱敏）"""
  authConfig: AuthConfig
}
